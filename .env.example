MINIMAX_API_KEY=your-key-here
# Optional override for mainland-region keys:
# MINIMAX_API_HOST=https://api.minimaxi.com

# Google Cloud TTS (default provider for single-character audio):
# Auth: run `gcloud auth application-default login`
#   or set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# Sentence audio uses MiniMax (better quality for longer text).
# Google TTS is used for short single-character audio.

# LLM for sentence generation (anki-chinese sentences):
GEMINI_API_KEY=your-gemini-key    # Free: https://aistudio.google.com/apikey
